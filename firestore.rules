rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        (
          (request.auth.token.email == 'wwzj012@gmail.com' && request.auth.token.email_verified == true) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    // Users Collection: Support both real Firebase users and local custom users (e.g. in offline or network-blocked environments)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Patterns Collection: User patterns can be read/written by anyone
    match /patterns/{patternId} {
      allow read, write: if true;
    }

    // VIP Redeem Codes Collection:
    // Support both real Firebase users and local custom users.
    // List/querying is protected, but lookups and redemptions (get and update) are public.
    match /vipCodes/{codeId} {
      allow list: if isAdmin();
      allow get: if true;
      allow create, delete: if isAdmin();
      // Allow marking an unused code as used
      allow update: if (resource.data.used == false && request.resource.data.used == true) || isAdmin();
    }

    // Audit Logs Collection
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
