{
  "name": "beadgrid-frontend",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:image-regression": "node scripts/image-regression.mjs",
    "test:algorithm-materials": "node scripts/algorithm-material-report.mjs",
    "test:serial": "vitest run --no-file-parallelism",
    "verify": "tsc --noEmit && vite build && vitest run --no-file-parallelism",
    "test:coverage": "vitest run --coverage --exclude \"**/*.browser.test.ts\" --exclude \"**/practiceBrowser.test.ts\" --exclude \"**/importLegend.test.ts\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "2.15.4",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "^10.4.21",
    "axe-core": "4.10.2",
    "jsdom": "25.0.1",
    "playwright-core": "^1.65.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10"
  }
}
